{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Playwright test (current file)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "args": ["playwright", "test", "${file}", "--headed", "--timeout=0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
